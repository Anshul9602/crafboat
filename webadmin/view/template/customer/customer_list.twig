<form id="form-customer" method="post" data-oc-toggle="ajax" data-oc-load="{{ action }}" data-oc-target="#customer">
  <div class="faire-bulkbar">
    <span class="faire-bulkbar__count">{{ customer_total }} Contacts</span>
    <div class="faire-bulkbar__actions">
      <span class="faire-toolbar__hint">Select customers to take an action</span>
      <button type="submit" formaction="{{ delete }}" onclick="return confirm('{{ text_confirm }}');" class="faire-tool faire-tool--danger"><i class="fa-regular fa-trash-can"></i> Delete</button>
    </div>
  </div>

  <div class="faire-table-wrap">
    <table class="faire-table">
      <thead>
        <tr>
          <th style="width:36px"><input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', $(this).prop('checked'));" class="form-check-input faire-check"/></th>
          <th><a href="{{ sort_name }}"{% if sort == 'name' %} class="{{ order|lower }}"{% endif %}>Store name</a></th>
          <th>Contact name</th>
          <th><a href="{{ sort_customer_group }}"{% if sort == 'customer_group' %} class="{{ order|lower }}"{% endif %}>Store type</a></th>
          <th>Total orders</th>
          <th>Order volume</th>
          <th><a href="{{ sort_email }}"{% if sort == 'c.email' %} class="{{ order|lower }}"{% endif %}>Email address</a></th>
          <th>Location</th>
          <th style="width:40px"></th>
        </tr>
      </thead>
      <tbody>
        {% if customers %}
          {% for customer in customers %}
            <tr{% if not customer.status %} class="opacity-50"{% endif %}>
              <td><input type="checkbox" name="selected[]" value="{{ customer.customer_id }}" class="form-check-input faire-check"/></td>
              <td>
                <div class="faire-customer-store">
                  <a class="faire-product-name" href="{{ customer.edit }}" style="text-transform:none">{{ customer.store_name }}</a>
                </div>
              </td>
              <td>{{ customer.name }}</td>
              <td class="faire-muted-cell">{{ customer.customer_group }}</td>
              <td>{{ customer.total_orders }}</td>
              <td>{{ customer.order_volume }}</td>
              <td class="faire-muted-cell">{{ customer.email }}</td>
              <td class="faire-muted-cell">{{ customer.location }}</td>
              <td class="text-end">
                <div class="dropdown">
                  <button type="button" class="faire-kebab" data-bs-toggle="dropdown" aria-label="Actions"><i class="fa-solid fa-ellipsis-vertical"></i></button>
                  <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" href="{{ customer.edit }}"><i class="fa-solid fa-pencil"></i> Edit</a></li>
                    {% if customer.unlock %}
                      <li><a class="dropdown-item" href="{{ customer.unlock }}" data-oc-toggle="unlock"><i class="fa-solid fa-unlock"></i> {{ text_unlock }}</a></li>
                    {% endif %}
                    {% for store in customer.store %}
                      <li><a class="dropdown-item" href="{{ store.href }}" target="_blank"><i class="fa-solid fa-right-to-bracket"></i> Login: {{ store.name }}</a></li>
                    {% endfor %}
                  </ul>
                </div>
              </td>
            </tr>
          {% endfor %}
        {% else %}
          <tr>
            <td colspan="9" class="faire-empty">{{ text_no_results }}</td>
          </tr>
        {% endif %}
      </tbody>
    </table>
  </div>
  <div class="faire-pager">
    {{ pagination }}
  </div>
</form>
