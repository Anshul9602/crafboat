{{ header }}{{ column_left }}
<div id="content">
  <div class="faire-page faire-page--wide">
    <div class="faire-page__head">
      <div>
        <h1 class="faire-page__title">{{ heading_title }}</h1>
      </div>
      <div class="faire-actions">
        <a href="{{ add }}" class="faire-btn">Add customers <i class="fa-solid fa-caret-down"></i></a>
      </div>
    </div>

    <nav class="faire-tabs" aria-label="Customer views">
      <a href="{{ filter_all }}"{% if status_tab == 'all' %} class="is-on"{% endif %}>All customers <span class="faire-tab-count">{{ total_all }}</span></a>
      <a href="{{ filter_enabled }}"{% if status_tab == 'enabled' %} class="is-on"{% endif %}>Active <span class="faire-tab-count">{{ total_enabled }}</span></a>
      <a href="{{ filter_potential }}"{% if status_tab == 'potential' %} class="is-on"{% endif %}>High potential customers <span class="faire-tab-count">Beta</span></a>
    </nav>

    {% if status_tab == 'potential' %}
      <section class="faire-insight">
        <div class="faire-insight__head">
          <div>
            <h2 class="faire-insight__title">Recommended actions to engage your customers</h2>
          </div>
          <div class="faire-insight__filters">
            <span class="faire-chip">Filter by: All accounts</span>
            <span class="faire-chip">Sort by: Highest order value</span>
          </div>
        </div>

        <div class="faire-reco-list">
          {% if recommendations %}
            {% for item in recommendations %}
              <article class="faire-reco">
                <div class="faire-reco__main">
                  <span class="faire-reco__badge{% if item.badge == 'Top account' %} faire-reco__badge--top{% elseif item.badge == 'New account' %} faire-reco__badge--new{% endif %}">{{ item.badge }}</span>
                  <div>
                    <a href="{{ item.href }}" class="faire-reco__store">{{ item.store }}</a>
                    <p class="faire-reco__insight">{{ item.insight }}</p>
                    <p class="faire-reco__tip">{{ item.tip }}</p>
                  </div>
                </div>
                <div class="faire-reco__actions">
                  <a href="{{ item.href }}" class="faire-link">{{ item.action }}</a>
                </div>
              </article>
            {% endfor %}
          {% else %}
            <div class="faire-empty">No recommendations yet. Add customers and orders to see insights.</div>
          {% endif %}
        </div>

        {% if recommendation_total %}
        <div class="faire-insight__foot">
          Showing 1-{{ recommendations|length }} out of {{ recommendation_total }}
        </div>
        {% endif %}
      </section>

      <section class="faire-segments">
        <h2 class="faire-insight__title">Customer segments for you</h2>
        <div class="faire-segment-grid">
          {% for segment in segments %}
            <a href="{{ segment.href }}" class="faire-segment-card">
              <div class="faire-segment-card__icon"><i class="fa-solid {{ segment.icon }}"></i></div>
              <div class="faire-segment-card__body">
                <h3>{{ segment.title }}</h3>
                <p>{{ segment.desc }}</p>
                <div class="faire-segment-card__stats">
                  <div>
                    <span>{{ segment.count_label }}</span>
                    <strong>{{ segment.count }}</strong>
                  </div>
                  <div>
                    <span>{{ segment.value_label }}</span>
                    <strong>{{ segment.value }}</strong>
                  </div>
                </div>
              </div>
              <i class="fa-solid fa-chevron-right faire-segment-card__arrow"></i>
            </a>
          {% endfor %}
        </div>
      </section>
    {% else %}
      <div class="faire-toolbar">
        <div class="faire-toolbar__left">
          <label class="faire-search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" id="input-name" name="filter_name" value="{{ filter_name }}" placeholder="Search customers" autocomplete="off"/>
          </label>
          <button type="button" id="button-filter" class="faire-chip"><i class="fa-solid fa-sliders"></i> Filter</button>
          <span class="faire-chip">All contacts ({{ total_customers }})</span>
        </div>
      </div>

      <div id="filter-customer" class="faire-filter-drawer d-none">
        <form id="form-filter" class="row g-3">
          <div class="col-md-3">
            <label class="form-label" for="input-email">{{ entry_email }}</label>
            <input type="text" name="filter_email" value="{{ filter_email }}" id="input-email" class="form-control"/>
          </div>
          <div class="col-md-3">
            <label class="form-label" for="input-customer-group">{{ entry_customer_group }}</label>
            <select name="filter_customer_group_id" id="input-customer-group" class="form-select">
              <option value=""></option>
              {% for customer_group in customer_groups %}
                <option value="{{ customer_group.customer_group_id }}"{% if customer_group.customer_group_id == filter_customer_group_id %} selected{% endif %}>{{ customer_group.name }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label" for="input-status">{{ entry_status }}</label>
            <select name="filter_status" id="input-status" class="form-select">
              <option value=""></option>
              <option value="1"{% if filter_status == '1' or filter_status == true %} selected{% endif %}>{{ text_enabled }}</option>
              <option value="0"{% if filter_status == '0' or filter_status is same as(false) %} selected{% endif %}>{{ text_disabled }}</option>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label" for="input-ip">{{ entry_ip }}</label>
            <input type="text" name="filter_ip" value="{{ filter_ip }}" id="input-ip" class="form-control"/>
          </div>
          <div class="col-md-3">
            <label class="form-label" for="input-date-from">{{ entry_date_from }}</label>
            <input type="date" name="filter_date_from" value="{{ filter_date_from }}" id="input-date-from" class="form-control"/>
          </div>
          <div class="col-md-3">
            <label class="form-label" for="input-date-to">{{ entry_date_to }}</label>
            <input type="date" name="filter_date_to" value="{{ filter_date_to }}" id="input-date-to" class="form-control"/>
          </div>
          <div class="col-12 text-end">
            <button type="button" id="button-apply-filter" class="faire-btn">Apply filters</button>
          </div>
        </form>
      </div>

      <div id="customer">{{ list }}</div>
    {% endif %}
  </div>
</div>
{% if status_tab != 'potential' %}
<script type="text/javascript"><!--
$('#customer').on('click', 'thead a, .pagination a', function(e) {
    e.preventDefault();
    $('#customer').load(this.href);
});

$('#button-filter').on('click', function() {
    $('#filter-customer').toggleClass('d-none');
});

function filterCustomers() {
    var url = '';
    var filter_name = $('#input-name').val();
    if (filter_name) url += '&filter_name=' + encodeURIComponent(filter_name);

    var filter_email = $('#input-email').val();
    if (filter_email) url += '&filter_email=' + encodeURIComponent(filter_email);

    var filter_customer_group_id = $('#input-customer-group').val();
    if (filter_customer_group_id !== '') url += '&filter_customer_group_id=' + filter_customer_group_id;

    var filter_status = $('#input-status').val();
    if (filter_status !== '') url += '&filter_status=' + filter_status;

    var filter_ip = $('#input-ip').val();
    if (filter_ip) url += '&filter_ip=' + encodeURIComponent(filter_ip);

    var filter_date_from = $('#input-date-from').val();
    if (filter_date_from) url += '&filter_date_from=' + encodeURIComponent(filter_date_from);

    var filter_date_to = $('#input-date-to').val();
    if (filter_date_to) url += '&filter_date_to=' + encodeURIComponent(filter_date_to);

    window.history.pushState({}, null, 'index.php?route=customer/customer&user_token={{ user_token }}&tab=all' + url);
    $('#customer').load('index.php?route=customer/customer.list&user_token={{ user_token }}' + url);
}

$('#button-apply-filter').on('click', filterCustomers);

$('#input-name').on('keydown', function(e) {
    if (e.keyCode == 13) {
        e.preventDefault();
        filterCustomers();
    }
});

$('#input-name').autocomplete({
    'source': function(request, response) {
        $.ajax({
            url: 'index.php?route=customer/customer.autocomplete&user_token={{ user_token }}&filter_name=' + encodeURIComponent(request),
            dataType: 'json',
            success: function(json) {
                response($.map(json, function(item) {
                    return { label: item['name'], value: item['customer_id'] };
                }));
            }
        });
    },
    'select': function(item) {
        $('#input-name').val(decodeHTMLEntities(item['label']));
        filterCustomers();
    }
});

$('#customer').on('click', '[data-oc-toggle=\'unlock\']', function(e) {
    e.preventDefault();
    var element = this;
    $.ajax({
        url: $(element).attr('href'),
        dataType: 'json',
        success: function(json) {
            $('.alert-dismissible').remove();
            if (json['error']) {
                $('#alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> ' + json['error'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
            }
            if (json['success']) {
                $('#alert').prepend('<div class="alert alert-success alert-dismissible"><i class="fa-solid fa-circle-check"></i> ' + json['success'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
            }
        }
    });
});
//--></script>
{% endif %}
{{ footer }}
