{{ header }}{{ column_left }}
<div id="content">
  <div class="faire-page faire-page--wide faire-promo-detail">
    <a href="{{ back }}" class="faire-back"><i class="fa-solid fa-arrow-left"></i> {{ heading_title }}</a>

    <div class="faire-promo-detail__head">
      <div>
        <h1 class="faire-page__title" id="promo-title-display">{{ page_title }}</h1>
        <div class="faire-promo-detail__meta">
          {% if not is_new %}
            <span class="faire-promo-status faire-promo-status--{{ lifecycle }}">{{ status_label }}</span>
            {% if updated_label %}<span class="faire-promo-detail__updated">{{ updated_label }}</span>{% endif %}
          {% else %}
            <span class="faire-promo-detail__updated">{{ text_form }}</span>
          {% endif %}
        </div>
      </div>
      <div class="faire-promo-detail__actions">
        {% if can_end %}
          <button type="button" class="faire-link" id="button-end-promo">{{ text_end_promotion }}</button>
        {% endif %}
        <button type="submit" form="form-coupon" formaction="{{ save }}" class="faire-btn">{{ button_save }}</button>
      </div>
    </div>

    {% if not is_new %}
      <section class="faire-promo-summary">
        <h2>{{ text_summary }}</h2>
        <div class="faire-promo-summary__grid">
          <div class="faire-promo-summary__primary">
            <article>
              <span>{{ text_metric_sales }}</span>
              <strong>{{ summary.sales }}</strong>
            </article>
            <article>
              <span>{{ text_metric_orders }}</span>
              <strong>{{ summary.orders }}</strong>
            </article>
          </div>
          <dl class="faire-promo-summary__secondary">
            <div><dt>{{ text_metric_aov }}</dt><dd>{{ summary.avg_order }}</dd></div>
            <div><dt>{{ text_metric_avg_discount }}</dt><dd>{{ summary.avg_discount }}</dd></div>
            <div><dt>{{ text_metric_units }}</dt><dd>{{ summary.units }}</dd></div>
            <div><dt>{{ text_metric_visits }}</dt><dd>{{ summary.product_visits }}</dd></div>
          </dl>
        </div>
      </section>

      <section class="faire-promo-orders">
        <div class="faire-promo-orders__head">
          <h2>{{ text_customers_orders }}</h2>
          <div class="faire-promo-orders__filters">
            <button type="button" class="faire-chip" disabled>{{ text_all_customers }} <i class="fa-solid fa-caret-down"></i></button>
            <button type="button" class="faire-chip" disabled>{{ text_all_orders }} <i class="fa-solid fa-caret-down"></i></button>
          </div>
        </div>
        <div class="faire-table-wrap faire-promo-orders__table">
          <table class="faire-table">
            <thead>
              <tr>
                <th>{{ column_order }}</th>
                <th>{{ column_customer }}</th>
                <th>{{ column_products }}</th>
                <th>{{ column_placed }}</th>
                <th class="text-end">{{ column_discount_amount }}</th>
                <th class="text-end">{{ column_item_subtotal }}</th>
              </tr>
            </thead>
            <tbody>
              {% if promo_orders %}
                {% for order in promo_orders %}
                  <tr>
                    <td><a href="{{ order.view }}" class="faire-promo-order-id">{{ order.order_code }}</a></td>
                    <td>
                      {% if order.customer_href %}
                        <a href="{{ order.customer_href }}" class="faire-promo-customer">{{ order.customer }}</a>
                      {% else %}
                        {{ order.customer }}
                      {% endif %}
                    </td>
                    <td>
                      <div class="faire-promo-thumbs">
                        {% for thumb in order.thumbs %}
                          <img src="{{ thumb.thumb }}" alt="{{ thumb.name }}" title="{{ thumb.name }}"/>
                        {% endfor %}
                        {% if order.extra %}<span class="faire-promo-thumbs__more">+{{ order.extra }}</span>{% endif %}
                      </div>
                    </td>
                    <td>{{ order.placed }}</td>
                    <td class="text-end">{{ order.discount }}</td>
                    <td class="text-end">{{ order.subtotal }}</td>
                  </tr>
                {% endfor %}
              {% else %}
                <tr>
                  <td colspan="6" class="faire-empty">{{ text_no_promo_orders }}</td>
                </tr>
              {% endif %}
            </tbody>
          </table>
        </div>
      </section>
    {% endif %}

    <section class="faire-promo-settings">
      <div class="faire-promo-settings__head">
        <h2>{{ text_settings }}</h2>
        <p>{{ text_settings_intro }}</p>
      </div>
      <form id="form-coupon" action="{{ save }}" method="post" data-oc-toggle="ajax" class="faire-promo-settings__form">
        <div class="faire-promo-field required">
          <label for="input-name">{{ entry_name }}</label>
          <input type="text" name="name" value="{{ name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control"/>
          <div id="error-name" class="invalid-feedback"></div>
        </div>
        <div class="faire-promo-field required">
          <label for="input-code">{{ entry_code }}</label>
          <input type="text" name="code" value="{{ code }}" placeholder="{{ entry_code }}" id="input-code" class="form-control"/>
          <div class="form-text">{{ help_code }}</div>
          <div id="error-code" class="invalid-feedback"></div>
        </div>
        <div class="faire-promo-field-row">
          <div class="faire-promo-field">
            <label for="input-type">{{ entry_type }}</label>
            <select name="type" id="input-type" class="form-select">
              <option value="P"{% if type == 'P' %} selected{% endif %}>{{ text_percent }}</option>
              <option value="F"{% if type == 'F' %} selected{% endif %}>{{ text_amount }}</option>
            </select>
          </div>
          <div class="faire-promo-field">
            <label for="input-discount">{{ entry_discount }}</label>
            <input type="text" name="discount" value="{{ discount }}" placeholder="{{ entry_discount }}" id="input-discount" class="form-control"/>
          </div>
          <div class="faire-promo-field">
            <label for="input-total">{{ entry_total }}</label>
            <input type="text" name="total" value="{{ total }}" placeholder="{{ entry_total }}" id="input-total" class="form-control"/>
          </div>
        </div>
        <div class="faire-promo-field-row">
          <div class="faire-promo-field">
            <label for="input-date-start">{{ entry_date }}</label>
            <div class="input-group">
              <input type="date" name="date_start" value="{{ date_start }}" id="input-date-start" class="form-control"/>
              <span class="input-group-text">–</span>
              <input type="date" name="date_end" value="{{ date_end }}" id="input-date-end" class="form-control"/>
            </div>
          </div>
          <div class="faire-promo-field">
            <label for="input-uses-total">{{ entry_uses_total }}</label>
            <input type="text" name="uses_total" value="{{ uses_total }}" id="input-uses-total" class="form-control"/>
          </div>
          <div class="faire-promo-field">
            <label for="input-uses-customer">{{ entry_uses_customer }}</label>
            <input type="text" name="uses_customer" value="{{ uses_customer }}" id="input-uses-customer" class="form-control"/>
          </div>
        </div>
        <div class="faire-promo-toggles">
          <label class="faire-promo-toggle">
            <span>{{ entry_logged }}</span>
            <input type="hidden" name="logged" value="0"/>
            <input type="checkbox" name="logged" value="1" class="form-check-input"{% if logged %} checked{% endif %}/>
          </label>
          <label class="faire-promo-toggle">
            <span>{{ entry_shipping }}</span>
            <input type="hidden" name="shipping" value="0"/>
            <input type="checkbox" name="shipping" value="1" class="form-check-input"{% if shipping %} checked{% endif %}/>
          </label>
          <label class="faire-promo-toggle">
            <span>{{ entry_status }}</span>
            <input type="hidden" name="status" value="0"/>
            <input type="checkbox" name="status" value="1" id="input-status" class="form-check-input"{% if status %} checked{% endif %}/>
          </label>
        </div>
        <div class="faire-promo-field">
          <label>{{ entry_product }}</label>
          <input type="text" name="product" value="" placeholder="{{ entry_product }}" id="input-product" data-oc-target="autocomplete-product" class="form-control" autocomplete="off"/>
          <ul id="autocomplete-product" class="dropdown-menu"></ul>
          <div class="faire-promo-picker">
            <table id="coupon-product" class="table m-0">
              <tbody>
                {% for coupon_product in coupon_products %}
                  <tr id="coupon-product-{{ coupon_product.product_id }}">
                    <td>{{ coupon_product.name }}<input type="hidden" name="coupon_product[]" value="{{ coupon_product.product_id }}"/></td>
                    <td class="text-end"><button type="button" class="btn btn-danger btn-sm"><i class="fa-solid fa-minus-circle"></i></button></td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
          <div class="form-text">{{ help_product }}</div>
        </div>
        <div class="faire-promo-field">
          <label>{{ entry_category }}</label>
          <input type="text" name="category" value="" placeholder="{{ entry_category }}" id="input-category" data-oc-target="autocomplete-category" class="form-control" autocomplete="off"/>
          <ul id="autocomplete-category" class="dropdown-menu"></ul>
          <div class="faire-promo-picker">
            <table id="coupon-category" class="table m-0">
              <tbody>
                {% for coupon_category in coupon_categories %}
                  <tr id="coupon-category-{{ coupon_category.category_id }}">
                    <td>{{ coupon_category.name }}<input type="hidden" name="coupon_category[]" value="{{ coupon_category.category_id }}"/></td>
                    <td class="text-end"><button type="button" class="btn btn-danger btn-sm"><i class="fa-solid fa-minus-circle"></i></button></td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
          <div class="form-text">{{ help_category }}</div>
        </div>
        <input type="hidden" name="coupon_id" value="{{ coupon_id }}" id="input-coupon-id"/>
      </form>
    </section>
  </div>
</div>
<script type="text/javascript"><!--
$('#input-name').on('input', function() {
  var val = $(this).val().trim();
  $('#promo-title-display').text(val || {{ text_add|json_encode|raw }});
});

$('#button-end-promo').on('click', function() {
  if (!confirm({{ text_confirm_end|json_encode|raw }})) return;
  $.ajax({
    url: '{{ end }}',
    type: 'post',
    dataType: 'json',
    data: { coupon_id: $('#input-coupon-id').val() },
    success: function(json) {
      if (json.error) { alert(json.error); return; }
      if (json.redirect) location = json.redirect;
      else location.reload();
    }
  });
});

$('#input-product').autocomplete({
  'source': function(request, response) {
    $.ajax({
      url: 'index.php?route=catalog/product.autocomplete&user_token={{ user_token }}&filter_name=' + encodeURIComponent(request),
      dataType: 'json',
      success: function(json) {
        response($.map(json, function(item) {
          return { label: item['name'], value: item['product_id'] };
        }));
      }
    });
  },
  'select': function(item) {
    $('#input-product').val('');
    $('#coupon-product-' + item['value']).remove();
    $('#coupon-product tbody').append('<tr id="coupon-product-' + item['value'] + '"><td>' + item['label'] + '<input type="hidden" name="coupon_product[]" value="' + item['value'] + '"/></td><td class="text-end"><button type="button" class="btn btn-danger btn-sm"><i class="fa-solid fa-minus-circle"></i></button></td></tr>');
  }
});
$('#coupon-product').on('click', '.btn', function() { $(this).closest('tr').remove(); });

$('#input-category').autocomplete({
  'source': function(request, response) {
    $.ajax({
      url: 'index.php?route=catalog/category.autocomplete&user_token={{ user_token }}&filter_name=' + encodeURIComponent(request),
      dataType: 'json',
      success: function(json) {
        response($.map(json, function(item) {
          return { label: item['name'], value: item['category_id'] };
        }));
      }
    });
  },
  'select': function(item) {
    $('#input-category').val('');
    $('#coupon-category-' + item['value']).remove();
    $('#coupon-category tbody').append('<tr id="coupon-category-' + item['value'] + '"><td>' + item['label'] + '<input type="hidden" name="coupon_category[]" value="' + item['value'] + '"/></td><td class="text-end"><button type="button" class="btn btn-danger btn-sm"><i class="fa-solid fa-minus-circle"></i></button></td></tr>');
  }
});
$('#coupon-category').on('click', '.btn', function() { $(this).closest('tr').remove(); });
//--></script>
{{ footer }}
