{{ header }}{{ column_left }}
<div id="content">
  <div class="faire-page faire-page--wide faire-affiliates">
    <div class="faire-page__head">
      <div>
        <h1 class="faire-page__title">{{ heading_title }}</h1>
        <p class="faire-page__intro">{{ text_intro }}</p>
      </div>
      <div class="faire-actions faire-affiliates__actions">
        <a href="{{ store }}" target="_blank" rel="noopener" class="faire-link">{{ text_view_shop }}</a>
        <button type="button" id="button-calculate" class="faire-btn faire-btn--ghost">{{ button_calculate }}</button>
        <button type="submit" form="form-affiliate" formaction="{{ csv }}" id="button-csv" class="faire-btn faire-btn--ghost">{{ button_csv }}</button>
        <button type="submit" form="form-affiliate" formaction="{{ complete }}" data-oc-toggle="ajax" id="button-complete" class="faire-btn faire-btn--ghost">{{ button_complete }}</button>
        <a href="{{ add }}" class="faire-btn">{{ text_add_partner }}</a>
        <button type="submit" form="form-affiliate" formaction="{{ delete }}" onclick="return confirm('{{ text_confirm }}');" class="faire-link">{{ button_delete }}</button>
      </div>
    </div>

    <section class="faire-affiliate-overview">
      <div class="faire-affiliate-overview__grid">
        <article>
          <span>{{ text_metric_partners }}</span>
          <strong>{{ overview.partners }}</strong>
        </article>
        <article>
          <span>{{ text_metric_active }}</span>
          <strong>{{ overview.active }}</strong>
        </article>
        <article>
          <span>{{ text_metric_balance }}</span>
          <strong>{{ overview.balance }}</strong>
        </article>
        <article>
          <span>{{ text_metric_commission }}</span>
          <strong>{{ overview.commission }}</strong>
        </article>
      </div>
    </section>

    <div class="faire-affiliate-list">
      <nav class="faire-tabs" aria-label="Affiliate filters">
        {% for tab in tabs %}
          <a href="{{ tab.href }}"{% if tab.active %} class="is-on"{% endif %}>{{ tab.label }}</a>
        {% endfor %}
      </nav>

      <div class="faire-affiliate-list__toolbar">
        <div class="faire-search faire-affiliate-list__search">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input type="search" id="input-affiliate-search" value="{{ filter_customer }}" placeholder="{{ text_search }}" autocomplete="off"/>
        </div>
        <button type="button" class="faire-chip" id="chip-affiliate-filters">{{ text_more_filters }} <i class="fa-solid fa-sliders"></i></button>
      </div>

      <div id="affiliate-filters" class="faire-affiliate-filters d-none">
        <div class="faire-affiliate-filters__grid">
          <div>
            <label for="input-tracking">{{ entry_tracking }}</label>
            <input type="text" id="input-tracking" value="{{ filter_tracking }}" class="form-control"/>
          </div>
          <div>
            <label for="input-payment-method">{{ entry_payment_method }}</label>
            <select id="input-payment-method" class="form-select">
              <option value="">{{ text_all }}</option>
              {% for payment_method in payment_methods %}
                <option value="{{ payment_method.value }}"{% if filter_payment_method == payment_method.value %} selected{% endif %}>{{ payment_method.text }}</option>
              {% endfor %}
            </select>
          </div>
          <div>
            <label for="input-commission">{{ entry_commission }}</label>
            <input type="text" id="input-commission" value="{{ filter_commission }}" class="form-control"/>
          </div>
          <div>
            <label for="input-date-from">{{ entry_date_from }}</label>
            <input type="date" id="input-date-from" value="{{ filter_date_from }}" class="form-control"/>
          </div>
          <div>
            <label for="input-date-to">{{ entry_date_to }}</label>
            <input type="date" id="input-date-to" value="{{ filter_date_to }}" class="form-control"/>
          </div>
        </div>
        <div class="faire-affiliate-filters__actions">
          <button type="button" id="button-filter" class="faire-btn">{{ button_filter }}</button>
          <button type="button" id="button-filter-reset" class="faire-link">{{ button_reset }}</button>
        </div>
      </div>

      <div id="affiliate">{{ list }}</div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
var affiliateToken = '{{ user_token }}';
var affiliateStatus = '{{ filter_status }}';

function faireAffiliateUrl() {
  var url = '';
  var search = $('#input-affiliate-search').val().trim();
  if (search) url += '&filter_customer=' + encodeURIComponent(search);
  if (affiliateStatus !== '') url += '&filter_status=' + encodeURIComponent(affiliateStatus);
  var tracking = $('#input-tracking').val().trim();
  if (tracking) url += '&filter_tracking=' + encodeURIComponent(tracking);
  var payment = $('#input-payment-method').val();
  if (payment) url += '&filter_payment_method=' + encodeURIComponent(payment);
  var commission = $('#input-commission').val().trim();
  if (commission) url += '&filter_commission=' + encodeURIComponent(commission);
  var from = $('#input-date-from').val();
  if (from) url += '&filter_date_from=' + encodeURIComponent(from);
  var to = $('#input-date-to').val();
  if (to) url += '&filter_date_to=' + encodeURIComponent(to);
  return url;
}

function faireAffiliateReload() {
  var url = faireAffiliateUrl();
  window.history.pushState({}, null, 'index.php?route=marketing/affiliate&user_token=' + affiliateToken + url);
  $('#affiliate').load('index.php?route=marketing/affiliate.list&user_token=' + affiliateToken + url);
}

var affiliateSearchTimer;
$('#input-affiliate-search').on('input', function() {
  clearTimeout(affiliateSearchTimer);
  affiliateSearchTimer = setTimeout(faireAffiliateReload, 350);
});

$('#chip-affiliate-filters').on('click', function() {
  $('#affiliate-filters').toggleClass('d-none');
});

$('#button-filter').on('click', faireAffiliateReload);
$('#button-filter-reset').on('click', function() {
  $('#input-tracking, #input-commission, #input-date-from, #input-date-to').val('');
  $('#input-payment-method').val('');
  faireAffiliateReload();
});

$('#affiliate').on('click', 'thead a, .pagination a', function(e) {
  e.preventDefault();
  $('#affiliate').load(this.href);
});

$('#button-calculate').on('click', function(e) {
  e.preventDefault();
  var element = this;
  $.ajax({
    url: 'index.php?route=marketing/affiliate.calculate&user_token=' + affiliateToken,
    dataType: 'json',
    beforeSend: function() { $(element).prop('disabled', true); },
    complete: function() { $(element).prop('disabled', false); },
    success: function(json) {
      if (json['error']) {
        $('#alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> ' + json['error'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
      }
      if (json['success']) {
        $('#alert').prepend('<div class="alert alert-success alert-dismissible"><i class="fa-solid fa-check-circle"></i> ' + json['success'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
        faireAffiliateReload();
      }
    }
  });
});
//--></script>
{{ footer }}
