<div class="faire-table-wrap faire-auto-table-wrap">
  <table class="faire-table faire-auto-table">
    <thead>
      <tr>
        <th>{{ column_automation }}</th>
        <th>{{ column_status }}</th>
        <th class="text-end">{{ column_delivered }}</th>
        <th class="text-end">{{ column_open_rate }}</th>
        <th class="text-end">{{ column_click_rate }}</th>
        <th class="text-end">{{ column_toggle }}</th>
      </tr>
    </thead>
    <tbody>
      {% if automations %}
        {% for automation in automations %}
          <tr>
            <td>
              <div class="faire-auto-name">{{ automation.name }}</div>
              <div class="faire-auto-desc">{{ automation.description }}</div>
            </td>
            <td>
              <span class="faire-promo-status faire-promo-status--{{ automation.lifecycle }}">{{ automation.status_label }}</span>
            </td>
            <td class="text-end">{{ automation.delivered }}</td>
            <td class="text-end">{{ automation.open_rate }}</td>
            <td class="text-end">{{ automation.click_rate }}</td>
            <td class="text-end">
              <label class="faire-auto-toggle">
                <input type="checkbox" data-id="{{ automation.automation_id }}"{% if automation.status %} checked{% endif %}/>
                <span></span>
              </label>
            </td>
          </tr>
        {% endfor %}
      {% else %}
        <tr>
          <td colspan="6" class="faire-empty">{{ text_no_results }}</td>
        </tr>
      {% endif %}
    </tbody>
  </table>
</div>
