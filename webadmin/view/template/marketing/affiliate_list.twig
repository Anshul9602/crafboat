<form id="form-affiliate" method="post" data-oc-load="{{ action }}" data-oc-target="#affiliate">
  <div class="faire-table-wrap faire-affiliate-table-wrap">
    <table class="faire-table faire-affiliate-table">
      <thead>
        <tr>
          <th class="faire-affiliate-table__check"><input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', $(this).prop('checked'));" class="form-check-input"/></th>
          <th><a href="{{ sort_name }}"{% if sort == 'name' %} class="{{ order|lower }}"{% endif %}>{{ column_partner }}</a></th>
          <th><a href="{{ sort_tracking }}"{% if sort == 'ca.tracking' %} class="{{ order|lower }}"{% endif %}>{{ column_tracking }}</a></th>
          <th class="text-end"><a href="{{ sort_commission }}"{% if sort == 'ca.commission' %} class="{{ order|lower }}"{% endif %}>{{ column_commission }}</a></th>
          <th class="text-end"><a href="{{ sort_balance }}"{% if sort == 'ca.balance' %} class="{{ order|lower }}"{% endif %}>{{ column_balance }}</a></th>
          <th><a href="{{ sort_date_added }}"{% if sort == 'ca.date_added' %} class="{{ order|lower }}"{% endif %}>{{ column_date_added }}</a></th>
          <th>{{ column_status }}</th>
        </tr>
      </thead>
      <tbody>
        {% if affiliates %}
          {% for affiliate in affiliates %}
            <tr>
              <td class="faire-affiliate-table__check"><input type="checkbox" name="selected[]" value="{{ affiliate.customer_id }}" class="form-check-input"/></td>
              <td>
                <a href="{{ affiliate.edit }}" class="faire-affiliate-name">{{ affiliate.name }}</a>
                {% if affiliate.company %}<div class="faire-affiliate-meta">{{ affiliate.company }}</div>{% endif %}
              </td>
              <td><code class="faire-affiliate-code">{{ affiliate.tracking }}</code></td>
              <td class="text-end">{{ affiliate.commission }}</td>
              <td class="text-end">{{ affiliate.balance }}</td>
              <td>{{ affiliate.date_added }}</td>
              <td><span class="faire-promo-status faire-promo-status--{{ affiliate.lifecycle }}">{{ affiliate.status_label }}</span></td>
            </tr>
          {% endfor %}
        {% else %}
          <tr>
            <td colspan="7" class="faire-empty">{{ text_empty }}</td>
          </tr>
        {% endif %}
      </tbody>
    </table>
  </div>
  <div class="faire-pager">{{ pagination }}</div>
</form>
