{{ header }}{{ column_left }}
<div id="content">
  <div class="faire-page faire-page--wide faire-automations">
    <div class="faire-page__head">
      <div>
        <h1 class="faire-page__title">{{ heading_title }}</h1>
      </div>
      <div class="faire-actions">
        <a href="mailto:hello@craftboat.com?subject=Automations%20feedback" class="faire-link">{{ text_share_feedback }}</a>
      </div>
    </div>

    <section class="faire-auto-hero" aria-label="{{ text_hero_title }}">
      <div class="faire-auto-hero__copy">
        <h2>{{ text_hero_title }}</h2>
        <p>{{ text_hero_body }}</p>
        <a href="#automations" class="faire-auto-hero__link">{{ text_hero_learn }}</a>
      </div>
      <div class="faire-auto-hero__art" aria-hidden="true">
        <div class="faire-auto-hero__bubble">{{ text_hero_bubble }}</div>
        <div class="faire-auto-hero__mail">
          <span>{{ text_hero_mail_label }}</span>
          <strong>{{ text_hero_mail_subject }}</strong>
        </div>
      </div>
    </section>

    <section class="faire-auto-setup">
      <div class="faire-auto-setup__copy">
        <h2>{{ text_setup_title }}</h2>
        {% if setup.complete %}
          <p class="faire-auto-setup__progress-copy">{{ text_setup_done }}</p>
        {% elseif setup.nearly_done %}
          <p class="faire-auto-setup__progress-copy">{{ text_setup_nearly }}</p>
        {% else %}
          <p class="faire-auto-setup__progress-copy">{{ text_setup_start }}</p>
        {% endif %}
        <div class="faire-auto-setup__bar" role="progressbar" aria-valuenow="{{ setup.progress }}" aria-valuemin="0" aria-valuemax="100">
          <span style="width: {{ setup.progress }}%"></span>
        </div>
        <div class="faire-auto-setup__count">{{ setup.label }}</div>
        {% if not setup.complete %}
          <a href="{{ setup.continue }}" class="faire-btn">{{ text_continue_setup }}</a>
        {% endif %}
      </div>
      <div class="faire-auto-setup__cards" aria-hidden="true">
        <article>{{ text_card_lapsed }}</article>
        <article>{{ text_card_90 }}</article>
        <article>{{ text_card_follower }}</article>
      </div>
    </section>

    <section class="faire-auto-summary">
      <div class="faire-auto-summary__head">
        <h2>{{ text_summary }}</h2>
        <span>{{ text_summary_period }}</span>
      </div>
      <div class="faire-auto-summary__grid">
        <article>
          <span>{{ text_metric_active }}</span>
          <strong>{{ summary.active }}</strong>
        </article>
        <article>
          <span>{{ text_metric_delivered }}</span>
          <strong>{{ summary.delivered }}</strong>
        </article>
        <article>
          <span>{{ text_metric_click }}</span>
          <strong>{{ summary.click_rate }}</strong>
        </article>
        <article>
          <span>{{ text_metric_revenue }}</span>
          <strong>{{ summary.revenue }}</strong>
        </article>
      </div>
    </section>

    <section class="faire-auto-list" id="automations">
      <nav class="faire-tabs" aria-label="Automation filters">
        {% for tab in tabs %}
          <a href="{{ tab.href }}"{% if tab.active %} class="is-on"{% endif %}>{{ tab.label }}</a>
        {% endfor %}
      </nav>
      <div id="marketing">{{ list }}</div>
    </section>
  </div>
</div>
<script type="text/javascript"><!--
$('#marketing').on('change', '.faire-auto-toggle input', function() {
  var $input = $(this);
  var $row = $input.closest('tr');
  var id = $input.data('id');
  var status = $input.is(':checked') ? 1 : 0;

  $.ajax({
    url: 'index.php?route=marketing/marketing.toggle&user_token={{ user_token }}',
    type: 'post',
    dataType: 'json',
    data: { automation_id: id, status: status },
    success: function(json) {
      if (json.error) {
        $input.prop('checked', !status);
        alert(json.error);
        return;
      }
      var $badge = $row.find('.faire-promo-status');
      $badge.removeClass('faire-promo-status--active faire-promo-status--off')
        .addClass('faire-promo-status--' + json.lifecycle)
        .text(json.status_label);
    },
    error: function() {
      $input.prop('checked', !status);
    }
  });
});
//--></script>
{{ footer }}
