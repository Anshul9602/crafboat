$('#email-canvas').on('click', '.cb-hero-placeholder, .cb-email-hero:not(.has-image)', function(e) {
    if ($(e.target).closest('.cb-media-toolbar, .cb-hero-logo a').length) return;
    e.preventDefault();
    e.stopPropagation();
    openImagePicker('hero', $(this).closest('.cb-email-hero'));
});

$('#email-canvas').on('click', '[data-media-action]', function(e) {
    e.preventDefault();
    e.stopPropagation();

    var action = $(this).data('media-action');
    var $media = $(this).closest('.cb-media');
    var block = $media.data('block');

    if (action === 'adjust') {
        if (block === 'hero') {
            openImagePicker('hero', $media);
        } else if (block === 'banner') {
            openImagePicker('banner', $media);
        } else if (block === 'logo') {
            openImagePicker('logo', $media);
        } else {
            openImagePicker('image', $media);
        }
        return;
    }

    if (action === 'delete') {
        if (block === 'hero') {
            $media.find('.cb-hero-img').remove();
            if (!$media.find('.cb-hero-placeholder').length) {
                $media.append('<div class="cb-hero-placeholder">Add a hero image</div>');
            }
            $media.removeClass('has-image');
            decorateMedia();
            syncMessage();
            return;
        }

        $media.remove();
        syncMessage();
    }
});

