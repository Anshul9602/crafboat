<form id="form-coupon" method="post" data-oc-toggle="ajax" data-oc-load="{{ action }}" data-oc-target="#coupon">
  <div class="faire-table-wrap faire-promo-table-wrap">
    <table class="faire-table faire-promo-table">
      <thead>
        <tr>
          <th class="faire-promo-table__check"><input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', $(this).prop('checked'));" class="form-check-input"/></th>
          <th>{{ column_promotion }}</th>
          <th>{{ column_dates }}</th>
          <th>{{ column_type }}</th>
          <th class="text-end">{{ column_sales }}</th>
          <th class="text-end">{{ column_orders }}</th>
          <th>{{ column_status }}</th>
        </tr>
      </thead>
      <tbody>
        {% if coupons %}
          {% for coupon in coupons %}
            <tr>
              <td class="faire-promo-table__check"><input type="checkbox" name="selected[]" value="{{ coupon.coupon_id }}" class="form-check-input"/></td>
              <td>
                <a href="{{ coupon.edit }}" class="faire-promo-name">{{ coupon.name }}</a>
                {% if coupon.code %}<div class="faire-promo-code">{{ coupon.code }}</div>{% endif %}
              </td>
              <td>{{ coupon.dates }}</td>
              <td>{{ coupon.type_label }}</td>
              <td class="text-end">{{ coupon.sales }}</td>
              <td class="text-end">{{ coupon.orders }}</td>
              <td>
                <span class="faire-promo-status faire-promo-status--{{ coupon.lifecycle }}">{{ coupon.status_label }}</span>
              </td>
            </tr>
          {% endfor %}
        {% else %}
          <tr>
            <td colspan="7" class="faire-empty">{{ text_no_results }}</td>
          </tr>
        {% endif %}
      </tbody>
    </table>
  </div>
  <div class="faire-pager">{{ pagination }}</div>
</form>
