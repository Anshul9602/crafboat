{{ header }}{{ column_left }}
<div id="content">
  <div class="faire-page faire-page--wide faire-orders">
    <div class="faire-orders__head">
      <h1 class="faire-page__title">{{ heading_title }}</h1>
      <div class="faire-orders__actions">
        <button type="submit" form="form-order" formaction="{{ invoice }}" formtarget="_blank" class="faire-link" id="button-export">{{ text_export }}</button>
        <div class="dropdown">
          <button type="button" class="faire-btn dropdown-toggle" data-bs-toggle="dropdown">{{ text_create_order }}</button>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item" href="{{ create }}"><i class="fa-solid fa-plus fa-fw"></i> {{ text_create_order }}</a></li>
            <li><a class="dropdown-item" href="{{ create }}"><i class="fa-solid fa-upload fa-fw"></i> {{ text_upload_order }}</a></li>
            <li><a class="dropdown-item" href="{{ issues }}"><i class="fa-regular fa-envelope fa-fw"></i> {{ text_forward_email }} <span class="faire-home-beta">{{ text_new }}</span></a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="faire-orders__card">
      <div class="faire-tabs faire-orders__tabs">
        {% for tab in tabs %}
          <a href="{{ tab.href }}" class="{% if tab.active %}is-on{% endif %}">{{ tab.label }}</a>
        {% endfor %}
      </div>

      <div class="faire-orders__toolbar">
        <div class="faire-search faire-orders__search">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input type="search" id="input-order-search" value="{{ filter_search }}" placeholder="{{ text_search_orders }}"/>
        </div>
        <div class="faire-orders__filters">
          <button type="button" class="faire-chip" id="chip-order-date">{{ text_order_date }}</button>
          <button type="button" class="faire-chip" id="chip-order-type">{{ text_order_type }}</button>
          <button type="button" class="faire-chip{% if filter_pending_ship %} is-on{% endif %}" id="chip-pending-ship">{{ text_pending_shipment }}</button>
        </div>
      </div>

      <div class="faire-orders__bulk">
        <button type="submit" form="form-order" formaction="{{ shipping }}" formtarget="_blank" class="faire-orders__bulk-btn" id="button-shipping" disabled><i class="fa-solid fa-print"></i> {{ text_print_slips }}</button>
        <button type="button" class="faire-orders__bulk-btn" id="button-ship-date" disabled><i class="fa-solid fa-truck"></i> {{ text_edit_ship_date }}</button>
        <button type="button" class="faire-orders__bulk-btn" id="button-ship-orders" disabled><i class="fa-solid fa-box"></i> {{ text_ship_orders }}</button>
        <div class="dropdown faire-orders__pick">
          <button type="button" class="faire-orders__bulk-btn dropdown-toggle" id="button-pick-list" data-bs-toggle="dropdown" disabled><i class="fa-solid fa-list"></i> {{ text_pick_list }}</button>
          <ul class="dropdown-menu">
            <li><button type="button" class="dropdown-item" id="button-pick-print"><i class="fa-solid fa-print fa-fw"></i> {{ text_print_pick_list }}</button></li>
            <li><button type="button" class="dropdown-item" id="button-pick-csv"><i class="fa-solid fa-download fa-fw"></i> {{ text_download_csv }}</button></li>
          </ul>
        </div>
      </div>

      <div id="order">{{ list }}</div>
    </div>
  </div>
</div>

<div class="modal fade faire-modal" id="modal-ship-date" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">{{ text_edit_ship_date }}</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p class="mb-2">Set the expected ship date for the selected order(s). You’ll see On time / Late after shipping.</p>
        <label class="form-label" for="input-expected-ship-date">Expected ship date</label>
        <input type="date" id="input-expected-ship-date" class="form-control"/>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="button-save-ship-date">Save ship date</button>
      </div>
    </div>
  </div>
</div>

<input type="hidden" id="input-date-from" value="{{ filter_date_from }}"/>
<input type="hidden" id="input-date-to" value="{{ filter_date_to }}"/>
<script type="text/javascript"><!--
function faireOrdersUrl() {
  var url = '';
  var tab = '{{ filter_tab }}';
  if (tab) url += '&filter_tab=' + encodeURIComponent(tab);

  var search = $('#input-order-search').val().trim();
  if (search) {
    if (/^\d+$/.test(search)) {
      url += '&filter_order_id=' + encodeURIComponent(search);
    } else {
      url += '&filter_customer=' + encodeURIComponent(search);
    }
  }

  var from = $('#input-date-from').val();
  var to = $('#input-date-to').val();
  if (from) url += '&filter_date_from=' + encodeURIComponent(from);
  if (to) url += '&filter_date_to=' + encodeURIComponent(to);

  if ($('#chip-pending-ship').hasClass('is-on')) {
    url += '&filter_pending_ship=1';
  }

  return url;
}

function faireOrdersReload() {
  var url = faireOrdersUrl();
  window.history.pushState({}, null, 'index.php?route=sale/order&user_token={{ user_token }}' + url);
  $('#order').load('index.php?route=sale/order.list&user_token={{ user_token }}' + url, function() {
    faireUpdateBulkButtons();
  });
}

function faireSelectedIds() {
  return $('#order input[name^=\'selected\']:checked').map(function() {
    return $(this).val();
  }).get();
}

function faireUpdateBulkButtons() {
  var selected = $('#order input[name^=\'selected\']:checked');
  var hasSelected = !!selected.length;

  $('#button-export, #button-ship-orders, #button-pick-list').prop('disabled', !hasSelected);

  var canEditShipDate = false;
  var canShip = false;

  selected.each(function() {
    var row = $(this).closest('tr');
    var expected = String(row.attr('data-expected-ship') || '').trim();

    // Enable Edit ship date only for orders that do not have a date yet
    if (!expected || expected === '0000-00-00') {
      canEditShipDate = true;
    }

    if (row.find('input[name^=\'shipping_method\']').val()) {
      canShip = true;
    }
  });

  $('#button-ship-date').prop('disabled', !canEditShipDate);
  $('#button-shipping').prop('disabled', !canShip);
}

function faireSubmitPickList(url, targetBlank) {
  var ids = faireSelectedIds();
  if (!ids.length) {
    alert('Select at least one order.');
    return;
  }

  var form = document.createElement('form');
  form.method = 'post';
  form.action = url;
  if (targetBlank) form.target = '_blank';

  ids.forEach(function(id) {
    var input = document.createElement('input');
    input.type = 'hidden';
    input.name = 'selected[]';
    input.value = id;
    form.appendChild(input);
  });

  document.body.appendChild(form);
  form.submit();
  document.body.removeChild(form);
}

$('#order').on('click', 'thead a, .pagination a', function(e) {
  e.preventDefault();
  $('#order').load(this.href);
});

$('#input-order-search').on('keydown', function(e) {
  if (e.key === 'Enter') {
    e.preventDefault();
    faireOrdersReload();
  }
});

$('#chip-pending-ship').on('click', function() {
  $(this).toggleClass('is-on');
  faireOrdersReload();
});

$('#chip-order-date').on('click', function() {
  var from = prompt('Order date from (YYYY-MM-DD)', $('#input-date-from').val() || '');
  if (from === null) return;
  var to = prompt('Order date to (YYYY-MM-DD)', $('#input-date-to').val() || from);
  if (to === null) return;
  $('#input-date-from').val(from);
  $('#input-date-to').val(to);
  faireOrdersReload();
});

$('#order').on('change', 'input[name^=\'selected\']', faireUpdateBulkButtons);

$('#button-ship-date').on('click', function() {
  if ($(this).prop('disabled')) return;

  var unset = $('#order input[name^=\'selected\']:checked').filter(function() {
    var expected = String($(this).closest('tr').attr('data-expected-ship') || '').trim();
    return !expected || expected === '0000-00-00';
  });

  if (!unset.length) {
    alert('Selected order(s) already have a ship date.');
    return;
  }

  $('#input-expected-ship-date').val(new Date().toISOString().slice(0, 10));
  bootstrap.Modal.getOrCreateInstance(document.getElementById('modal-ship-date')).show();
});

$('#button-save-ship-date').on('click', function() {
  var ids = $('#order input[name^=\'selected\']:checked').filter(function() {
    var expected = String($(this).closest('tr').attr('data-expected-ship') || '').trim();
    return !expected || expected === '0000-00-00';
  }).map(function() {
    return $(this).val();
  }).get();

  var shipDate = $('#input-expected-ship-date').val();

  if (!ids.length) {
    alert('Selected order(s) already have a ship date.');
    return;
  }
  if (!shipDate) {
    alert('Choose an expected ship date.');
    return;
  }

  var form = new FormData();
  form.append('ship_date', shipDate);
  ids.forEach(function(id) {
    form.append('selected[]', id);
  });

  $.ajax({
    url: {{ ship_date|json_encode|raw }},
    type: 'post',
    data: form,
    processData: false,
    contentType: false,
    dataType: 'json',
    success: function(json) {
      if (json['error']) {
        alert(json['error']);
        return;
      }
      var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('modal-ship-date'));
      modal.hide();
      faireOrdersReload();
    },
    error: function(xhr) {
      alert('Could not save ship date. ' + (xhr.responseText ? xhr.responseText.substring(0, 180) : ''));
    }
  });
});

$('#button-ship-orders').on('click', function() {
  var ids = faireSelectedIds();
  if (!ids.length) return;

  var shipped = prompt('Shipped date (YYYY-MM-DD)', new Date().toISOString().slice(0, 10));
  if (!shipped) return;

  var form = new FormData();
  form.append('shipped_date', shipped);
  ids.forEach(function(id) {
    form.append('selected[]', id);
  });

  $.ajax({
    url: {{ ship_orders|json_encode|raw }},
    type: 'post',
    data: form,
    processData: false,
    contentType: false,
    dataType: 'json',
    success: function(json) {
      if (json['error']) {
        alert(json['error']);
        return;
      }
      faireOrdersReload();
    },
    error: function(xhr) {
      alert('Could not mark orders shipped. ' + (xhr.responseText ? xhr.responseText.substring(0, 180) : ''));
    }
  });
});

$('#button-pick-print').on('click', function() {
  faireSubmitPickList({{ pick_list|json_encode|raw }}, true);
});

$('#button-pick-csv').on('click', function() {
  faireSubmitPickList({{ pick_list_csv|json_encode|raw }}, false);
});

faireUpdateBulkButtons();
//--></script>
{{ footer }}
