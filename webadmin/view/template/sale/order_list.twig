<form id="form-order" method="post" data-oc-load="{{ action }}" data-oc-target="#order">
  <div class="faire-orders__table-wrap">
    <table class="faire-orders__table">
      <thead>
        <tr>
          <th class="faire-orders__check"><input type="checkbox" onclick="$('#order input[name*=\'selected\']').prop('checked', this.checked).trigger('change');" class="form-check-input"/></th>
          <th><a href="{{ sort_order }}"{% if sort == 'o.order_id' %} class="{{ order|lower }}"{% endif %}>{{ column_order }}</a></th>
          <th><a href="{{ sort_status }}"{% if sort == 'order_status' %} class="{{ order|lower }}"{% endif %}>{{ column_status }}</a></th>
          <th><a href="{{ sort_customer }}"{% if sort == 'customer' %} class="{{ order|lower }}"{% endif %}>{{ column_customer }}</a></th>
          <th class="text-end"><a href="{{ sort_total }}"{% if sort == 'o.total' %} class="{{ order|lower }}"{% endif %}>{{ column_total }}</a></th>
          <th><a href="{{ sort_date_added }}"{% if sort == 'o.date_added' %} class="{{ order|lower }}"{% endif %}>{{ column_order_date }}</a></th>
          <th>{{ column_ship_date }}</th>
        </tr>
      </thead>
      <tbody>
        {% if orders %}
          {% for order in orders %}
            <tr data-expected-ship="{{ order.expected_ship_date }}">
              <td class="faire-orders__check">
                <input type="checkbox" name="selected[]" value="{{ order.order_id }}" class="form-check-input"/>
                <input type="hidden" name="shipping_method[]" value="{% if order.shipping_method %}1{% else %}0{% endif %}"/>
              </td>
              <td><a href="{{ order.view }}" class="faire-orders__id">{{ order.order_code }}</a></td>
              <td><span class="faire-orders__status faire-orders__status--{{ order.status_class }}">{{ order.order_status }}</span></td>
              <td>
                <div class="faire-orders__customer">{{ order.customer_display }}</div>
                {% if order.message_href %}
                  <a href="{{ order.message_href }}" class="faire-orders__msg" title="Message"><i class="fa-regular fa-comment"></i></a>
                {% endif %}
              </td>
              <td class="text-end">{{ order.total }}</td>
              <td>{{ order.date_added }}</td>
              <td>
                <div class="faire-orders__ship">{{ order.ship_date }}</div>
                {% if order.ship_track %}
                  <span class="faire-orders__ship-track faire-orders__ship-track--{{ order.ship_track_class }}">{{ order.ship_track }}</span>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        {% else %}
          <tr>
            <td colspan="7" class="text-center faire-orders__empty">{{ text_no_results }}</td>
          </tr>
        {% endif %}
      </tbody>
    </table>
  </div>
  <div class="faire-pager">{{ pagination }}</div>
</form>
