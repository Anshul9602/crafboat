<!DOCTYPE html>
<html dir="{{ direction }}" lang="{{ lang }}">
<head>
  <meta charset="UTF-8"/>
  <title>{{ title }}</title>
  <base href="{{ base }}"/>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      padding: 36px 48px;
      color: #111;
      background: #fff;
      font: 13px/1.45 Inter, Helvetica, Arial, sans-serif;
    }
    .slip {
      page-break-after: always;
      max-width: 980px;
      margin: 0 auto 40px;
    }
    .slip:last-child { page-break-after: auto; }
    .slip-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 24px;
      margin-bottom: 36px;
    }
    .slip-logo img {
      display: block;
      max-height: 64px;
      max-width: 220px;
      width: auto;
      height: auto;
    }
    .slip-logo__text {
      font-family: Georgia, "Times New Roman", serif;
      font-size: 28px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }
    .slip-title {
      margin: 8px 0 0;
      font-size: 28px;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .slip-grid {
      display: grid;
      grid-template-columns: 1.1fr 1.4fr 1fr;
      gap: 28px;
      margin-bottom: 34px;
    }
    .slip-label {
      display: block;
      margin-bottom: 8px;
      color: #8a867e;
      font-size: 12px;
    }
    .slip-from strong,
    .slip-ship strong {
      display: block;
      font-size: 15px;
      font-weight: 600;
      margin-bottom: 2px;
    }
    .slip-badge {
      display: inline-block;
      margin-top: 8px;
      padding: 3px 8px;
      border: 1px solid #cfc9bf;
      border-radius: 4px;
      color: #6b6760;
      font-size: 11px;
    }
    .slip-ship div,
    .slip-meta div {
      margin-bottom: 2px;
    }
    .slip-meta-row {
      display: grid;
      grid-template-columns: 92px 1fr;
      gap: 8px;
      margin-bottom: 8px;
    }
    .slip-meta-row span {
      color: #8a867e;
    }
    .slip-meta-row strong {
      font-weight: 600;
    }
    table {
      width: 100%;
      border-collapse: collapse;
    }
    th, td {
      padding: 14px 10px;
      border-bottom: 1px solid #e7e2d8;
      text-align: left;
      vertical-align: top;
    }
    th {
      border-bottom: 2px solid #d8d2c7;
      color: #6b6760;
      font-size: 12px;
      font-weight: 500;
    }
    td.sku { width: 140px; white-space: nowrap; }
    td.item { text-transform: uppercase; letter-spacing: 0.01em; font-weight: 500; }
    td.item small {
      display: block;
      margin-top: 4px;
      color: #6b6760;
      text-transform: none;
      font-weight: 400;
    }
    td.qty, th.qty,
    td.wsp, th.wsp,
    td.sub, th.sub {
      text-align: right;
      white-space: nowrap;
    }
    td.wsp em {
      display: block;
      margin-top: 4px;
      color: #8a867e;
      font-style: normal;
      font-size: 11px;
    }
    .slip-foot {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      margin-top: 28px;
      color: #8a867e;
      font-size: 12px;
    }
    .no-print { margin-bottom: 16px; }
    .no-print button {
      padding: 8px 16px;
      border: 0;
      background: #111;
      color: #fff;
      cursor: pointer;
    }
    @media print {
      body { padding: 12px; }
      .no-print { display: none !important; }
    }
  </style>
</head>
<body>
  <div class="no-print"><button type="button" onclick="window.print()">Print packing slips</button></div>

  {% for order in orders %}
    <section class="slip">
      <div class="slip-head">
        <div class="slip-logo">
          {% if logo %}
            <img src="{{ logo }}" alt="{{ order.store_name }}"/>
          {% else %}
            <div class="slip-logo__text">{{ order.store_name }}</div>
          {% endif %}
        </div>
        <h1 class="slip-title">Packing Slip</h1>
      </div>

      <div class="slip-grid">
        <div class="slip-from">
          <span class="slip-label">From</span>
          <strong>{{ order.store_name }}</strong>
          {% if order.first_order %}<span class="slip-badge">First order</span>{% endif %}
        </div>

        <div class="slip-ship">
          <span class="slip-label">Ship To</span>
          {% for name in order.ship_to_names %}
            <strong>{{ name }}</strong>
          {% endfor %}
          {% for line in order.ship_to_lines %}
            <div>{{ line }}</div>
          {% endfor %}
          {% if order.telephone %}<div>{{ order.telephone }}</div>{% endif %}
        </div>

        <div class="slip-meta">
          <div class="slip-meta-row"><span>Order #</span><strong>{{ order.order_code }}</strong></div>
          <div class="slip-meta-row"><span>Order Date</span><strong>{{ order.date_added }}</strong></div>
          <div class="slip-meta-row"><span>Ship Date</span><strong>{% if order.ship_date %}{{ order.ship_date }}{% else %}&nbsp;{% endif %}</strong></div>
        </div>
      </div>

      <table>
        <thead>
          <tr>
            <th>SKU</th>
            <th>Item</th>
            <th class="qty">Qty.</th>
            <th class="wsp">WSP</th>
            <th class="sub">Subtotal</th>
          </tr>
        </thead>
        <tbody>
          {% for product in order.product %}
            <tr>
              <td class="sku">{{ product.sku }}</td>
              <td class="item">
                {{ product.name }}
                {% for option in product.option %}
                  <small>{{ option.name }}: {{ option.value }}</small>
                {% endfor %}
              </td>
              <td class="qty">{{ product.quantity }}</td>
              <td class="wsp">
                {{ product.wsp }}
                <em>SRP {{ product.srp }}</em>
              </td>
              <td class="sub">{{ product.subtotal }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>

      <div class="slip-foot">
        <div>{{ order.store_url }}</div>
        <div>{{ order.page }}</div>
      </div>
    </section>
  {% else %}
    <p>No packing slips available for the selected orders.</p>
  {% endfor %}
</body>
</html>
