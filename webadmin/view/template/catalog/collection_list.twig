<form id="form-collection" method="post" data-oc-toggle="ajax" data-oc-load="{{ action }}" data-oc-target="#collection">
  <div class="faire-table-wrap">
    <table class="faire-table">
      <thead>
        <tr>
          <th style="width:36px"><input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', $(this).prop('checked'));" class="form-check-input faire-check"/></th>
          <th style="width:64px">{{ column_image }}</th>
          <th>{{ column_name }}</th>
          <th>{{ column_quantity }}</th>
          <th>{{ column_status }}</th>
          <th>{{ column_promotion }}</th>
          <th class="text-end">{{ column_action }}</th>
        </tr>
      </thead>
      <tbody>
        {% if collections %}
          {% for collection in collections %}
            <tr>
              <td><input type="checkbox" name="selected[]" value="{{ collection.collection_id }}" class="form-check-input faire-check"/></td>
              <td><img class="faire-thumb" src="{{ collection.image }}" alt="{{ collection.name }}"></td>
              <td>
                <div class="faire-name">
                  <strong>{{ collection.name }}</strong>
                  <span>{{ collection.updated }}</span>
                </div>
              </td>
              <td>{{ collection.quantity }}</td>
              <td><span class="faire-badge faire-badge--{{ collection.status_class }}">{{ collection.status_label }}</span></td>
              <td><a class="faire-link" href="{{ collection.edit }}">{{ text_promotion }}</a></td>
              <td class="text-end"><a href="{{ collection.edit }}" class="faire-btn faire-btn--ghost" style="padding:8px 12px"><i class="fa-solid fa-pencil"></i></a></td>
            </tr>
          {% endfor %}
        {% else %}
          <tr>
            <td colspan="7" class="faire-empty">{{ text_no_results }}</td>
          </tr>
        {% endif %}
      </tbody>
    </table>
  </div>
  {% if pagination %}
  <div class="faire-pager">{{ pagination }}</div>
  {% endif %}
</form>
