<form id="form-product" method="post" data-oc-toggle="ajax" data-oc-load="{{ action }}" data-oc-target="#product">
  <div class="faire-table-wrap">
    <table class="faire-table">
      <thead>
        <tr>
          <th style="width:36px"><input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', $(this).prop('checked'));" class="form-check-input faire-check"/></th>
          <th style="width:56px"></th>
          <th><a href="{{ sort_name }}"{% if sort == 'pd.name' %} class="{{ order|lower }}"{% endif %}>Product name</a></th>
          <th>Options</th>
          <th><a href="{{ sort_price }}"{% if sort == 'p.price' %} class="{{ order|lower }}"{% endif %}>WS price</a></th>
          <th>Status</th>
          <th><a href="{{ sort_quantity }}"{% if sort == 'p.quantity' %} class="{{ order|lower }}"{% endif %}>Availability</a></th>
          <th>Recent sales</th>
          <th>Improvement areas</th>
          <th style="width:40px"></th>
        </tr>
      </thead>
      <tbody>
        {% if products %}
          {% for product in products %}
            <tr>
              <td><input type="checkbox" name="selected[]" value="{{ product.product_id }}" class="form-check-input faire-check"/></td>
              <td><img class="faire-thumb" src="{{ product.image }}" alt="{{ product.name }}"></td>
              <td><a class="faire-product-name" href="{{ product.edit }}">{{ product.name }}</a></td>
              <td class="faire-muted-cell">{{ product.options_label }}</td>
              <td>{{ product.special ? product.special : product.price }}</td>
              <td>{{ product.status ? 'Published' : 'Unpublished' }}</td>
              <td><span class="faire-pill">{{ product.availability }}</span></td>
              <td class="faire-muted-cell"></td>
              <td class="faire-muted-cell"></td>
              <td class="text-end">
                <div class="dropdown">
                  <button type="button" class="faire-kebab" data-bs-toggle="dropdown" aria-label="Actions"><i class="fa-solid fa-ellipsis-vertical"></i></button>
                  <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" href="{{ product.edit }}"><i class="fa-solid fa-pencil"></i> Edit</a></li>
                    {% if product.variant %}
                    <li><a class="dropdown-item" href="{{ product.variant }}"><i class="fa-solid fa-plus"></i> {{ text_variant_add }}</a></li>
                    {% endif %}
                  </ul>
                </div>
              </td>
            </tr>
          {% endfor %}
        {% else %}
          <tr>
            <td colspan="10" class="faire-empty">{{ text_no_results }}</td>
          </tr>
        {% endif %}
      </tbody>
    </table>
  </div>
  <div class="faire-pager">
    {{ pagination }}
  </div>
</form>
