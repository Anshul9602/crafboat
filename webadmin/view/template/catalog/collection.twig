{{ header }}{{ column_left }}
<div id="content">
  <div class="faire-page">
    <div class="faire-page__head">
      <div>
        <h1 class="faire-page__title">{{ heading_title }}</h1>
        <p class="faire-page__intro">{{ text_intro }} <a href="https://www.faire.com/support" target="_blank" rel="noopener">{{ text_learn }}</a></p>
      </div>
      <div class="faire-actions">
        <button type="submit" form="form-collection" formaction="{{ delete }}" onclick="return confirm('{{ text_confirm }}');" class="faire-btn faire-btn--ghost"><i class="fa-regular fa-trash-can"></i></button>
        <a href="{{ add }}" class="faire-btn">{{ text_create }}</a>
      </div>
    </div>

    <nav class="faire-tabs" aria-label="Collection status">
      <a href="{{ filter_published }}"{% if filter == 'published' %} class="is-on"{% endif %}>{{ text_published }} ({{ total_published }})</a>
      <a href="{{ filter_draft }}"{% if filter == 'draft' %} class="is-on"{% endif %}>{{ text_drafts }} ({{ total_draft }})</a>
      <a href="{{ filter_unpublished }}"{% if filter == 'unpublished' %} class="is-on"{% endif %}>{{ text_unpublished }} ({{ total_unpublished }})</a>
    </nav>

    <div id="collection">{{ list }}</div>
  </div>
</div>
{{ footer }}
