{% if histories %}
  <div class="cb-order__timeline">
    {% for history in histories %}
      <div class="cb-order__timeline-row">
        <div class="cb-order__timeline-date">{{ history.date_added }}</div>
        <div class="cb-order__timeline-body">
          <strong>{{ history.status }}</strong>
          {% if history.comment %}<span>{{ history.comment }}</span>{% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
  <div class="cb-orders__pager">
    <div>{{ pagination }}</div>
    <div>{{ results }}</div>
  </div>
{% else %}
  <p class="cb-order__note">{{ text_no_results }}</p>
{% endif %}
